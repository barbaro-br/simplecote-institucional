---
/**
 * Moldura das "telas" recriadas do produto no deck da landing.
 * Categoria A — HTML/CSS puro, sem JS.
 * Portado de simplecote-front/src/site/tech/telas/TelaCard.tsx
 */
interface Props {
  titulo: string
  pulso?: boolean
  class?: string
}

const { titulo, pulso = false, class: className } = Astro.props
---

<div class="relative w-full min-w-0 max-w-2xl">
  <!-- glow decorativo atrás do card -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -inset-8 -z-10 rounded-[2.5rem] bg-[var(--brand-mint,#3fae7a)]/20 blur-3xl"
  ></div>

  <!-- Superficie (card glass escuro) -->
  <div
    class:list={[
      'overflow-hidden rounded-2xl border shadow-[0_40px_100px_-20px_rgba(0,0,0,0.75)]',
      'border-[rgba(255,255,255,0.1)]',
      'bg-[#12263f]',
      'ring-1 ring-inset ring-[rgba(255,255,255,0.06)]',
      className,
    ]}
  >
    <!-- SecaoCabecalho -->
    <div class="flex items-center justify-between gap-3 border-b border-[rgba(255,255,255,0.1)] px-4 py-2.5 sm:px-5">
      <div class="flex min-w-0 items-center gap-2 text-[13px] font-medium text-white">
        <span class="relative flex size-2 shrink-0">
          {pulso && (
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--brand-mint,#57bf8e)]/70"></span>
          )}
          <span class="relative inline-flex size-2 rounded-full bg-[var(--brand-mint,#57bf8e)]"></span>
        </span>
        <span class="truncate">{titulo}</span>
      </div>
      <div class="flex shrink-0 items-center gap-2">
        <span class="rounded-full border border-white/15 px-2 py-0.5 text-[10px] uppercase tracking-wide text-white/50">
          Simulação
        </span>
      </div>
    </div>

    <!-- conteúdo -->
    <slot />
  </div>
</div>
