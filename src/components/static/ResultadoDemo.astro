---
/**
 * Demo da tela de Resultado da cotação (vencedor de cada item).
 * Categoria A — HTML/CSS puro, zero JS.
 * Portado de simplecote-front/src/site/tech/telas/ResultadoDemo.tsx
 *
 * A função moeda() é inlined aqui pois não podemos importar de @/shared.
 */
import TelaCard from './TelaCard.astro'

function moeda(valor: number): string {
  return new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(valor)
}

const ITENS: { item: string; vencedor: string; preco: number; economia: number }[] = [
  { item: 'Arroz tipo 1', vencedor: 'Meridiano', preco: 152.4, economia: 21.6 },
  { item: 'Feijão carioca', vencedor: 'Litoral', preco: 74.2, economia: 7.8 },
  { item: 'Óleo de soja', vencedor: 'Meridiano', preco: 128.9, economia: 13.1 },
  { item: 'Açúcar refinado', vencedor: 'Aurora', preco: 49.6, economia: 6.9 },
  { item: 'Café torrado', vencedor: 'Litoral', preco: 138.4, economia: 20.6 },
]

const total = ITENS.reduce((s, i) => s + i.economia, 0)
---

<TelaCard titulo="Resultado da cotação">
  <div class="flex items-center justify-between border-b border-white/10 px-4 py-2.5 text-[11px] text-white/50 sm:px-5">
    <span>Vencedor de cada item</span>
    <span class="text-white/70">5 itens · 3 fornecedores</span>
  </div>

  <ul class="divide-y divide-white/[0.07]">
    {ITENS.map(({ item, vencedor, preco, economia }) => (
      <li class="flex items-center gap-3 px-4 py-2.5 sm:px-5">
        <div class="min-w-0 flex-1">
          <div class="truncate text-[13px] font-medium text-white">{item}</div>
          <div class="flex items-center gap-1 text-[11px] text-white/45">
            <!-- Trophy icon (phosphor) -->
            <svg class="size-3 text-[var(--brand-mint,#3fae7a)]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
              <path d="M232,64H208V48a8,8,0,0,0-8-8H56a8,8,0,0,0-8,8V64H24A16,16,0,0,0,8,80V96a40,40,0,0,0,40,40H55.36A88.09,88.09,0,0,0,120,207.62V232H96a8,8,0,0,0,0,16h64a8,8,0,0,0,0-16H136V207.62A88.09,88.09,0,0,0,200.64,136H208a40,40,0,0,0,40-40V80A16,16,0,0,0,232,64ZM48,120a24,24,0,0,1-24-24V80H48v40Zm80,72a72,72,0,0,1-72-72V56H200v64A72.08,72.08,0,0,1,128,192Zm80-96V80h24V96a24,24,0,0,1-24,24Z"/>
            </svg>
            {vencedor}
          </div>
        </div>
        <div class="text-right">
          <div class="text-[13px] font-semibold text-white tabular-nums">{moeda(preco)}</div>
          <div class="text-[11px] font-medium text-[var(--brand-mint-bright,#6fe6a8)] tabular-nums">
            −{moeda(economia)}
          </div>
        </div>
      </li>
    ))}
  </ul>

  <div class="flex items-center justify-between gap-3 border-t border-white/10 bg-white/[0.03] px-4 py-3 sm:px-5">
    <div>
      <div class="text-[11px] text-white/50">Economia total nesta cotação</div>
      <div class="text-lg font-bold text-[var(--brand-mint-bright,#6fe6a8)] tabular-nums">{moeda(total)}</div>
    </div>
    <span class="rounded-lg bg-[var(--brand-mint,#3fae7a)] px-3 py-1.5 text-xs font-semibold text-[var(--brand-navy-deep,#122040)]">
      Gerar pedidos
    </span>
  </div>
</TelaCard>
