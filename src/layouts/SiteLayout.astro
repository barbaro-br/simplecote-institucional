---
/**
 * Layout base do site institucional — shell de "app" em tela cheia.
 *  - header estático (nav: Home, Como funciona, Preços, Ajuda, Sobre nós) + CTA
 *  - <main> sem scroll (flex-1, overflow-hidden); cada página ocupa 100vh
 *  - faixa marquee persistente na base (sem footer)
 *  - CursorMais em todas as páginas
 *  - SEO: title/description/og:* via props — nunca useEffect
 *
 * Links "Criar conta"/"Entrar" apontam para app.simplecote.app conforme spec.
 */
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css'
import BrandLogo from '../components/static/BrandLogo.astro'
import CursorMais from '../components/enhanced/CursorMais.astro'
import BotaoMagnetico from '../components/enhanced/BotaoMagnetico.astro'
import Marquee from '../components/enhanced/Marquee.astro'
import { HeroFundo } from '../components/islands/HeroFundo'

interface Props {
  titulo: string
  descricao: string
  ogImage?: string
  /** quando true, não renderiza header/marquee (para usar dentro de outras layouts) */
  sem_chrome?: boolean
}

const { titulo, descricao, ogImage, sem_chrome = false } = Astro.props

const caminho = Astro.url.pathname
const ativo = (p: string) => (p === '/' ? caminho === '/' : caminho.startsWith(p))

const DIFERENCIAIS = [
  'Sem fidelidade',
  'Cancele quando quiser',
  'Suporte em português',
  'Grade ao vivo em todos os planos',
] as const
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter />
  </head>
  <body class="flex h-dvh flex-col overflow-hidden text-foreground bg-background">
    <HeroFundo client:load transition:persist transition:name="hero-fundo" />
    <CursorMais />

    {!sem_chrome && (
      <header
        id="site-header"
        class="relative w-full shrink-0 bg-background/80 backdrop-blur-md"
      >
        <div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-4">
          <a
            href="/"
            aria-label="SimpleCote — página inicial"
            data-cursor="mais"
          >
            <BrandLogo tom="claro" />
          </a>

          <div class="flex items-center gap-3 sm:gap-6">
            <!-- Nav desktop -->
            <nav class="hidden items-center gap-6 sm:flex" aria-label="Navegação principal">
              {[
                ['/', 'Home'],
                ['/como-funciona', 'Como funciona'],
                ['/precos', 'Preços'],
                ['/sobre-nos', 'Sobre nós'],
                ['/ajuda', 'Ajuda'],
              ].map(([href, rotulo]) => (
                <a
                  href={href}
                  aria-current={ativo(href) ? 'page' : undefined}
                  class={ativo(href)
                    ? 'text-sm font-medium text-accent [text-shadow:0_0_10px_var(--accent)]'
                    : 'text-sm text-text-2 transition-colors hover:text-accent'}
                >
                  {rotulo}
                </a>
              ))}
              <a
                href="https://app.simplecote.app/login"
                class="text-sm font-medium text-text-1 hover:underline"
                data-cursor="mais"
              >
                Entrar
              </a>
            </nav>

            <BotaoMagnetico
              href="https://app.simplecote.app/cadastro"
              class="inline-flex items-center justify-center gap-1.5 rounded-md text-sm font-medium transition-all duration-200 focus-visible:outline-none focus-visible:ring-1 h-9 px-4 py-2 bg-accent text-accent-foreground shadow hover:bg-accent/90 max-sm:px-3 max-sm:text-xs"
              data-cursor="mais"
            >
              Criar conta
            </BotaoMagnetico>

            <!-- Modo apresentação (toggle opt-in) -->
            <button
              type="button"
              id="demo-toggle"
              aria-label="Ativar modo apresentação"
              aria-pressed="false"
              title="Modo apresentação"
              class="flex size-9 items-center justify-center rounded-md text-text-2 transition-colors hover:bg-surface-2 hover:text-text-1"
            >
              <svg class="size-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" aria-hidden>
                <path d="M240,128a15.74,15.74,0,0,1-7.6,13.51L88.32,229.65a16,16,0,0,1-16.2.3A15.86,15.86,0,0,1,64,216.13V39.87a15.86,15.86,0,0,1,8.12-13.82,16,16,0,0,1,16.2.3L232.4,114.49A15.74,15.74,0,0,1,240,128Z"/>
              </svg>
            </button>

            <!-- Menu mobile toggle (JS progressivo) -->
            <button
              type="button"
              id="menu-toggle"
              aria-label="Abrir menu"
              aria-expanded="false"
              aria-controls="menu-mobile"
              class="flex size-9 items-center justify-center rounded-md text-text-1 transition-colors hover:bg-surface-2 sm:hidden"
            >
              <svg id="menu-icon-aberto" class="size-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" aria-hidden>
                <path d="M224,128a8,8,0,0,1-8,8H40a8,8,0,0,1,0-16H216A8,8,0,0,1,224,128ZM40,72H216a8,8,0,0,0,0-16H40a8,8,0,0,0,0,16ZM216,184H40a8,8,0,0,0,0,16H216a8,8,0,0,0,0-16Z"/>
              </svg>
              <svg id="menu-icon-fechar" class="hidden size-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" aria-hidden>
                <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Menu mobile -->
        <div
          id="menu-mobile"
          class="hidden absolute inset-x-0 top-full border-b border-border bg-background/95 shadow-lg backdrop-blur-md sm:hidden"
        >
          <nav class="mx-auto flex max-w-6xl flex-col px-4 py-1" aria-label="Menu mobile">
            {[
              ['/', 'Home'],
              ['/como-funciona', 'Como funciona'],
              ['/precos', 'Preços'],
              ['/sobre-nos', 'Sobre nós'],
              ['/ajuda', 'Ajuda'],
              ['https://app.simplecote.app/login', 'Entrar'],
            ].map(([href, rotulo]) => (
              <a
                href={href}
                aria-current={ativo(href) ? 'page' : undefined}
                class={ativo(href)
                  ? 'border-b border-border/40 py-3 text-sm font-medium text-accent last:border-0'
                  : 'border-b border-border/40 py-3 text-sm font-medium text-foreground last:border-0'}
              >
                {rotulo}
              </a>
            ))}
          </nav>
        </div>
      </header>
    )}

    <main class="flex-1 min-h-0 overflow-hidden">
      <slot />
    </main>

    {!sem_chrome && (
      <div class="relative z-10 shrink-0 border-t border-border bg-bg-deep/80 py-3 backdrop-blur-md">
        <Marquee class="mx-auto max-w-6xl">
          {DIFERENCIAIS.map((item) => (
            <span class="mx-6 flex items-center gap-2 text-sm font-medium text-text-2">
              <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
              {item}
            </span>
          ))}
        </Marquee>
      </div>
    )}

    <script>
      const toggle = document.getElementById('menu-toggle')
      const menu = document.getElementById('menu-mobile')
      const iconAberto = document.getElementById('menu-icon-aberto')
      const iconFechar = document.getElementById('menu-icon-fechar')

      if (toggle && menu) {
        toggle.addEventListener('click', () => {
          const aberto = menu.classList.toggle('hidden')
          toggle.setAttribute('aria-expanded', String(!aberto))
          toggle.setAttribute('aria-label', aberto ? 'Abrir menu' : 'Fechar menu')
          iconAberto?.classList.toggle('hidden', !aberto)
          iconFechar?.classList.toggle('hidden', aberto)
        })

        // Fecha no Escape
        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
            menu.classList.add('hidden')
            toggle.setAttribute('aria-expanded', 'false')
            toggle.setAttribute('aria-label', 'Abrir menu')
            iconAberto?.classList.remove('hidden')
            iconFechar?.classList.add('hidden')
          }
        })
      }

      // Modo apresentação: ciclo automático de páginas (opt-in, ~25s)
      const ROTAS_DEMO = ['/', '/como-funciona', '/precos', '/sobre-nos', '/ajuda']
      const DEMO_KEY = 'sc-demo'
      const INTERVALO_DEMO = 25000
      const demoToggle = document.getElementById('demo-toggle')

      const demoAtivo = () => {
        try { return localStorage.getItem(DEMO_KEY) === '1' } catch { return false }
      }
      const atualizarDemoBtn = () => {
        if (!demoToggle) return
        const on = demoAtivo()
        demoToggle.setAttribute('aria-pressed', String(on))
        demoToggle.setAttribute('aria-label', on ? 'Desativar modo apresentação' : 'Ativar modo apresentação')
        demoToggle.classList.toggle('text-accent', on)
      }
      const agendarDemo = () => {
        const atual = window.location.pathname
        const idx = ROTAS_DEMO.indexOf(atual)
        const proxima = ROTAS_DEMO[(idx + 1) % ROTAS_DEMO.length]
        window.setTimeout(() => {
          if (demoAtivo()) window.location.href = proxima
        }, INTERVALO_DEMO)
      }

      atualizarDemoBtn()
      if (demoAtivo()) agendarDemo()

      demoToggle?.addEventListener('click', () => {
        try {
          if (demoAtivo()) localStorage.removeItem(DEMO_KEY)
          else localStorage.setItem(DEMO_KEY, '1')
        } catch {}
        atualizarDemoBtn()
        if (demoAtivo()) agendarDemo()
      })
    </script>
  </body>
</html>
