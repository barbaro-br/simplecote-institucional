---
import SiteLayout from '../layouts/SiteLayout.astro'
---

<SiteLayout
	titulo="SimpleCote — Cotações competitivas para supermercados"
	descricao="SimpleCote: leilão reverso para supermercados cotarem e economizarem com fornecedores, sem planilha."
>
	<main class="mx-auto max-w-3xl px-4 py-24 text-center">
		<h1 class="text-4xl font-bold tracking-tight">SimpleCote</h1>
		<p class="mt-4 text-lg text-neutral-600">
			Cotações competitivas para supermercados. Projeto Astro em construção —
			próximo passo: trazer o conteúdo real da home atual.
		</p>
	</main>
</SiteLayout>
