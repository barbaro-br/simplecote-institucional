---
/**
 * Página Home — /
 * Shell em tela cheia: apenas o hero em formato "stories" (DeckHero).
 * As seções "Como funciona" e "Planos" têm páginas próprias (acessíveis pelo header).
 */
import SiteLayout from '../layouts/SiteLayout.astro'
import { DeckHero } from '../components/islands/DeckHero'
---

<SiteLayout
  titulo="SimpleCote — Cotações competitivas para supermercados"
  descricao="SimpleCote: leilão reverso para supermercados cotarem e economizarem com fornecedores, sem planilha."
  ogImage="/hero.png"
>
  <div class="relative h-full overflow-hidden">

    <div class="relative z-10 h-full">
      <DeckHero client:load />
    </div>
  </div>
</SiteLayout>
